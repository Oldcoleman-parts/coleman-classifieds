{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run test:ai)",
      "Bash(npm run test:ai:*)",
      "Bash(npm run lint)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck)",
      "Bash(npx prisma migrate dev:*)",
      "Bash(npx prisma generate)",
      "Bash(npx prettier:*)",
      "Bash(node scripts/progress.mjs:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git tag)",
      "Bash(git tag -l:*)",
      "Bash(git rev-parse:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout -b:*)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(shopify app dev:*)",
      "Bash(npm test:*)",
      "Bash(git tag review-:*)",
      "Bash(pg_dump:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Bash(shopify app deploy:*)",
      "Bash(npx prisma migrate deploy:*)",
      "Bash(npx prisma migrate reset:*)",
      "Bash(git push:*)",
      "Bash(aws:*)",
      "Bash(psql:*)",
      "Bash(pg_restore:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/progress.mjs --summary 2>/dev/null; echo 'Tip: /next shows the exact next command.'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/format-hook.mjs"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node scripts/progress.mjs --statusline 2>/dev/null"
  }
}