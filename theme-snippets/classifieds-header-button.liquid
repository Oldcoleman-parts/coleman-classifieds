{%- comment -%}
  Classifieds header button (F06-T2). Copied into the OCP theme as
  snippets/classifieds-header-button.liquid; see docs/reference/theme-install.md.

  Shown only while at least one listing is live (`classifieds.live_count`, written only by
  the app). Place it in the header icon area beside Search/Account/Cart and first in the
  mobile drawer, NEVER in the main menu row, so no menu link moves into "More".

  {% render 'classifieds-header-button', variant: 'header' %}
  {% render 'classifieds-header-button', variant: 'drawer' %}

  Header: icon only from 990px to 1279px (where the menu row is tight), icon and word from
  1280px; a fixed size that never grows or shrinks the icon row.
{%- endcomment -%}
{%- assign cc_live = shop.metafields.classifieds.live_count.value | plus: 0 -%}
{%- if cc_live > 0 -%}
  {%- assign cc_href = routes.root_url | append: '/pages/classifieds' | replace: '//', '/' -%}
  {%- assign cc_variant = variant | default: 'header' -%}
  <a
    href="{{ cc_href | escape }}"
    class="cc-header-button cc-header-button--{{ cc_variant | escape }}"
    aria-label="Classifieds"
  >
    <svg class="cc-header-button__icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
        d="M9 3h6M12 3v2M8 7h8l-1 2H9L8 7zM9 9c-1.5 1.5-2 3-2 5s.5 3.5 2 5h6c1.5-1.5 2-3 2-5s-.5-3.5-2-5M10 13h4M10 21h4M12 12v4"/>
    </svg>
    <span class="cc-header-button__label">Classifieds</span>
  </a>
  <style>
    .cc-header-button {
      align-items: center;
      border: 1.5px solid #b3261e;
      border-radius: 999px;
      box-sizing: border-box;
      color: #1b2a4a;
      display: inline-flex;
      flex: 0 0 auto;
      gap: 6px;
      line-height: 1;
      max-width: 132px;
      padding: 6px 12px;
      text-decoration: none;
      white-space: nowrap;
    }
    .cc-header-button:hover,
    .cc-header-button:focus-visible {
      background: rgba(179, 38, 30, 0.08);
    }
    .cc-header-button__icon {
      flex: 0 0 auto;
    }
    .cc-header-button--header .cc-header-button__label {
      display: none;
    }
    .cc-header-button--header {
      padding: 6px;
    }
    @media (min-width: 1280px) {
      .cc-header-button--header {
        padding: 6px 12px;
      }
      .cc-header-button--header .cc-header-button__label {
        display: inline;
      }
    }
    @media (max-width: 989px) {
      /* On phones the drawer copy is the one shown. */
      .cc-header-button--header {
        display: none;
      }
    }
    .cc-header-button--drawer {
      margin: 0 0 12px;
    }
  </style>
{%- endif -%}
